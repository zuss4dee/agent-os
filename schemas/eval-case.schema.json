{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/eval-case.schema.json",
  "title": "EvalCase",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "task", "expected_properties", "failure_conditions", "scoring"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "expected_properties": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "criteria"],
      "properties": {
        "type": { "type": "string", "enum": ["rubric", "outcome"] },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "weight"],
            "properties": {
              "name": { "type": "string" },
              "weight": { "type": "number", "exclusiveMinimum": 0 },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
